  <!-- INTERACTIVE SPEC DETAILS CASE STUDY MODAL -->
  <div id="project-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm transition-opacity duration-300">
    <div class="tech-border bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-500 max-w-2xl w-full p-6 md:p-8 relative shadow-[0_0_50px_rgba(6,182,212,0.3)] max-h-[90vh] overflow-y-auto">
      <!-- CLOSE BUTTON -->
      <button type="button" onclick="closeProjectModal()" class="absolute top-4 right-4 text-gray-500 dark:text-cyan-400 hover:text-red-500 dark:hover:text-red-400 text-xl font-bold p-2 focus:outline-none transition-colors">
        <i class="fas fa-times"></i>
      </button>

      <!-- MODAL IMAGE -->
      <div class="h-60 rounded overflow-hidden mb-6 bg-gray-900 border border-gray-200 dark:border-cyan-950">
        <img id="modal-project-img" src="" alt="Project Preview" class="w-full h-full object-cover">
      </div>

      <!-- MODAL CATEGORY & TITLE -->
      <span id="modal-project-category" class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-widest block mb-1"></span>
      <h3 id="modal-project-title" class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-wider mb-4"></h3>
      
      <!-- MODAL DESCRIPTION -->
      <p id="modal-project-desc" class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6"></p>

      <!-- MODAL TECH STACK -->
      <div class="mb-8">
        <h4 class="text-xs font-black text-gray-900 dark:text-cyan-300 uppercase tracking-widest mb-3">// ARCHITECTURE_STACK</h4>
        <div id="modal-project-tech" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- MODAL ACTION LINKS -->
      <div class="flex items-center justify-end space-x-4 border-t border-gray-200 dark:border-cyan-950/60 pt-4">
        <a id="modal-project-github" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-2 text-xs font-black uppercase tracking-wider px-4 py-2 bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-cyan-400 rounded hover:bg-gray-200 dark:hover:bg-cyan-950/50 transition-colors">
          <i class="fab fa-github"></i>
          <span>SOURCE_CODE</span>
        </a>
        <button type="button" onclick="closeProjectModal()" class="inline-flex items-center space-x-2 text-xs font-black uppercase tracking-wider px-4 py-2 bg-gradient-to-r from-cyan-500 to-green-500 text-gray-950 rounded hover:opacity-90 transition-opacity">
          <span>CLOSE_TERMINAL</span>
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION SYSTEM -->
  <div id="toast-notif" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 pointer-events-none transition-all duration-300 max-w-sm w-full bg-white dark:bg-cyber-card border border-cyan-500 shadow-[0_0_20px_rgba(6,182,212,0.4)] p-4 rounded tech-border">
    <div class="flex items-start space-x-3">
      <div id="toast-icon-bg" class="w-8 h-8 rounded bg-cyan-500/20 text-cyan-400 flex items-center justify-center flex-shrink-0">
        <i id="toast-icon" class="fas fa-check-circle"></i>
      </div>
      <div class="flex-1">
        <h5 id="toast-title" class="text-xs font-black uppercase tracking-wider text-gray-900 dark:text-white"></h5>
        <p id="toast-message" class="text-xs text-gray-600 dark:text-gray-400 mt-1 leading-relaxed"></p>
      </div>
      <button type="button" onclick="hideToast()" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-xs">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
