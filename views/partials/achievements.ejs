  <!-- ACHIEVEMENTS & CERTIFICATIONS MATRIX -->
  <section id="achievements" class="py-24 bg-gray-100/40 dark:bg-cyber-card/30 border-y border-gray-200 dark:border-cyan-950/40 relative">
    <div class="container mx-auto px-6 max-w-5xl">
      
      <!-- SECTION TITLE -->
      <div class="flex items-center space-x-3 mb-16 justify-center">
        <div class="w-3 h-6 bg-cyan-400 shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
        <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-widest text-center">
          03 // ACHIEVEMENTS_&_CREDENTIALS
        </h2>
      </div>

      <!-- ACHIEVEMENTS GRID -->
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <% if (achievements && achievements.length > 0) { %>
          <% achievements.forEach(function(item) { %>
            <div class="tech-border bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-950/70 p-6 rounded relative group hover:border-cyan-500/80 hover:shadow-[0_0_25px_rgba(6,182,212,0.25)] transition-all duration-300">
              <!-- TOP BADGE -->
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block px-3 py-1 bg-cyan-500/10 dark:bg-cyan-500/20 border border-cyan-500/40 text-cyan-600 dark:text-cyan-400 text-xs font-black uppercase tracking-widest rounded shadow-[0_0_10px_rgba(6,182,212,0.2)]">
                  <%= item.badge %>
                </span>
                <i class="<%= item.icon %> text-xl text-cyan-500 dark:text-cyan-400 <%= item.glow || '' %>"></i>
              </div>

              <!-- CONTENT -->
              <h3 class="text-lg font-black text-gray-900 dark:text-white uppercase tracking-wide mb-1">
                <%= item.title %>
              </h3>
              
              <div class="text-xs font-bold text-green-600 dark:text-green-400 uppercase tracking-wider mb-3">
                <%= item.highlight %>
              </div>

              <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
                <%= item.description %>
              </p>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- CERTIFICATIONS BANNER -->
      <% if (certifications && certifications.length > 0) { %>
        <div class="tech-border bg-gradient-to-r from-cyan-950/20 via-cyber-card to-cyan-950/30 border border-cyan-500/40 p-6 md:p-8 rounded shadow-xl">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            
            <div class="flex items-center space-x-5">
              <div class="w-16 h-16 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-3xl text-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)] flex-shrink-0">
                <i class="fab fa-microsoft"></i>
              </div>
              
              <div>
                <div class="inline-block px-2.5 py-0.5 bg-green-500/20 border border-green-500/40 text-green-400 text-[10px] font-black uppercase tracking-widest rounded mb-1">
                  OFFICIAL_CERTIFICATION // AZ-900
                </div>
                <h4 class="text-lg md:text-xl font-black text-gray-900 dark:text-white uppercase tracking-wider">
                  <%= certifications[0].title %>
                </h4>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-1 max-w-xl">
                  <%= certifications[0].description %>
                </p>
              </div>
            </div>

            <div class="flex-shrink-0">
              <span class="inline-flex items-center space-x-2 px-4 py-2 border border-cyan-500 text-cyan-400 rounded text-xs font-black uppercase tracking-wider bg-cyan-500/10 shadow-[0_0_12px_rgba(6,182,212,0.2)]">
                <i class="fas fa-certificate"></i>
                <span>VERIFIED_CREDENTIAL</span>
              </span>
            </div>

          </div>
        </div>
      <% } %>

    </div>
  </section>
