  <!-- SKILLS SECTION -->
  <section id="skills" class="py-24 relative">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="flex items-center space-x-3 mb-16 justify-center">
        <div class="w-3 h-6 bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.8)]"></div>
        <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-widest text-center">
          02 // TECH_STACK_MATRIX
        </h2>
      </div>

      <!-- SKILLS GRID -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
        <% if (skills && skills.length > 0) { %>
          <% skills.forEach(function(skill) { %>
            <div class="group bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-950/60 p-6 rounded flex flex-col items-center justify-center text-center transition-all duration-300 hover:border-cyan-500 hover:shadow-[0_0_20px_rgba(6,182,212,0.25)] hover:-translate-y-1">
              <img src="<%= skill.icon %>" alt="<%= skill.name %>" class="w-12 h-12 mb-3 <%= skill.glow || '' %> <%= skill.customClass || '' %> transition-transform duration-300 group-hover:scale-110">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-800 dark:text-cyan-300">
                <%= skill.name %>
              </span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>
