  <!-- ABOUT SECTION (CORE PROFILE) -->
  <section class="py-24 bg-gray-100/60 dark:bg-cyber-card/40 border-y border-gray-200 dark:border-cyan-950/40 backdrop-blur-sm relative" id="about">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="tech-border bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-900/50 p-8 md:p-12 shadow-2xl relative">
        
        <!-- SECTION HEADER -->
        <div class="flex items-center space-x-3 mb-8">
          <div class="w-3 h-6 bg-cyan-500 shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
          <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-wider">
            01 // CORE_PROFILE
          </h2>
        </div>
        
        <!-- ABOUT DESCRIPTION PARAGRAPHS -->
        <div class="space-y-6 text-gray-700 dark:text-gray-300 text-sm md:text-base leading-relaxed">
          <% if (profile.aboutParagraphs && profile.aboutParagraphs.length > 0) { %>
            <% profile.aboutParagraphs.forEach(function(para) { %>
              <p><%- para %></p>
            <% }); %>
          <% } %>
        </div>

        <!-- QUICK CORE PILLARS MATRIX -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-gray-200 dark:border-cyan-950/60">
          <div class="p-4 bg-gray-50 dark:bg-cyber-bg/60 rounded border border-gray-200 dark:border-cyan-950/80">
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block">DSA Solved</span>
            <span class="text-base font-black text-cyan-500 dark:text-cyan-400 uppercase">500+ Problems</span>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-cyber-bg/60 rounded border border-gray-200 dark:border-cyan-950/80">
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block">Competitive</span>
            <span class="text-base font-black text-green-500 dark:text-green-400 uppercase">CodeVita AIR 2034</span>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-cyber-bg/60 rounded border border-gray-200 dark:border-cyan-950/80">
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block">Backend Engine</span>
            <span class="text-base font-black text-purple-500 dark:text-purple-400 uppercase">Node / Express / EJS</span>
          </div>
          <div class="p-4 bg-gray-50 dark:bg-cyber-bg/60 rounded border border-gray-200 dark:border-cyan-950/80">
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block">Cloud Certified</span>
            <span class="text-base font-black text-cyan-400 uppercase">Azure (AZ-900)</span>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="<%= profile.resumeLink || '/IMG/ME.jpg' %>" download class="inline-flex items-center space-x-3 border-2 border-cyan-500 text-cyan-600 dark:text-cyan-400 px-6 py-2.5 rounded font-bold uppercase tracking-wider hover:bg-cyan-500 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(6,182,212,0.15)]">
            <i class="fas fa-download"></i>
            <span>DOWNLOAD_SPEC_RESUME</span>
          </a>
          <a href="mailto:<%= profile.email %>" class="inline-flex items-center space-x-2 text-gray-600 dark:text-gray-300 hover:text-cyan-400 text-sm font-bold uppercase tracking-wider transition-colors px-4 py-2">
            <i class="fas fa-envelope text-cyan-500"></i>
            <span><%= profile.email %></span>
          </a>
        </div>
      </div>
    </div>
  </section>
