  <!-- HERO SECTION -->
  <section id="home" class="min-h-screen flex flex-col md:flex-row items-center justify-center px-6 md:px-20 gap-12 pt-28 pb-16">
    <div class="text-center md:text-left md:w-1/2 space-y-6">
      
      <!-- OPERATIONAL BADGE & LOCATION -->
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 bg-cyan-500/10 border border-cyan-500/30 rounded-full text-cyan-400 text-xs font-bold uppercase tracking-widest shadow-[0_0_15px_rgba(6,182,212,0.15)]">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span><%= profile.status || 'SYSTEMS_OPERATIONAL' %></span>
        </div>
        <div class="inline-flex items-center space-x-1.5 px-3 py-1 bg-green-500/10 border border-green-500/30 rounded-full text-green-400 text-xs font-bold uppercase tracking-wider">
          <i class="fas fa-location-dot text-[10px]"></i>
          <span><%= profile.location || 'Bhopal, India' %></span>
        </div>
      </div>
      
      <!-- HERO TITLE & GLITCH TEXT -->
      <h1 class="text-4xl md:text-7xl font-black tracking-tight text-gray-900 dark:text-white uppercase leading-tight">
        Hi, I'm <br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-400 to-green-400 glitch-hover cursor-default">
          <%= profile.name || 'Arun Kahar' %>
        </span>
      </h1>
      
      <!-- SUBTITLE / DYNAMIC TYPING TEXT -->
      <div class="h-8 md:h-10 flex items-center justify-center md:justify-start">
        <p class="text-base md:text-2xl font-bold text-cyan-600 dark:text-cyan-300 tracking-widest uppercase">
          [ <span id="typing-text" class="border-r-2 border-cyan-400 pr-1 text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-green-400">FULL_STACK_DEVELOPER</span> ]
        </p>
      </div>
      
      <!-- HERO BIO -->
      <p class="text-gray-600 dark:text-gray-400 max-w-md text-sm md:text-base leading-relaxed">
        <%= profile.bio %>
      </p>

      <!-- CTA BUTTONS & QUICK CONTACTS -->
      <div class="pt-4 flex flex-wrap items-center justify-center md:justify-start gap-4">
        <a href="#projects" class="inline-block px-8 py-3 bg-gradient-to-r from-cyan-500 to-teal-500 hover:from-teal-500 hover:to-cyan-500 text-cyber-bg dark:text-white font-black uppercase tracking-wider rounded shadow-[0_0_20px_rgba(6,182,212,0.4)] transition-all duration-300 hover:scale-105">
          VIEW_PROJECTS.EXE
        </a>
        <a href="#contact" class="inline-block px-6 py-3 border border-cyan-500/50 hover:border-cyan-400 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-500/10 font-bold uppercase tracking-wider rounded transition-all duration-300">
          CONTACT_ME
        </a>
      </div>

      <!-- DIRECT CONTACT HIGHLIGHTS -->
      <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs font-mono text-gray-500 dark:text-gray-400">
        <a href="mailto:<%= profile.email %>" class="hover:text-cyan-400 transition-colors flex items-center space-x-1.5">
          <i class="fas fa-envelope text-cyan-500"></i>
          <span><%= profile.email %></span>
        </a>
        <span class="text-cyan-900">•</span>
        <a href="tel:<%= profile.phone %>" class="hover:text-cyan-400 transition-colors flex items-center space-x-1.5">
          <i class="fas fa-phone text-green-500"></i>
          <span><%= profile.phone %></span>
        </a>
      </div>
    </div>

    <!-- RIGHT SIDE GRAPHIC PROFILE AVATAR -->
    <div class="md:w-1/2 flex justify-center">
      <div class="relative group">
        <!-- TECH FRAME GLOW MATRIX -->
        <div class="absolute -inset-2 rounded-full bg-gradient-to-r from-cyan-500 to-green-500 opacity-40 blur-lg group-hover:opacity-75 transition-opacity duration-700"></div>
        <div class="w-56 h-56 md:w-64 md:h-64 rounded-full p-1 bg-gradient-to-tr from-cyan-400 via-transparent to-green-400 relative z-10 overflow-hidden shadow-2xl">
          <img src="<%= profile.avatar || '/IMG/ME.jpg' %>" alt="<%= profile.name %> Photo" class="w-full h-full object-cover rounded-full filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700">
        </div>
        <!-- ABSOLUTE INTERFACE OVERLAYS -->
        <div class="absolute -bottom-2 -right-2 bg-white dark:bg-cyber-card border border-cyan-500/50 px-3 py-1 rounded text-[10px] text-cyan-600 dark:text-cyan-400 tracking-widest font-bold uppercase shadow-xl z-20">
          ID: <%= profile.terminalId || 'ARUN_DEV_2026' %>
        </div>
      </div>
    </div>
  </section>
