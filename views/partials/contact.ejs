  <!-- CONTACT / COMMS CHANNELS -->
  <section class="py-24 relative" id="contact">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="tech-border bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-900/40 p-8 md:p-12 shadow-2xl relative">
        
        <!-- SECTION TITLE -->
        <div class="flex items-center space-x-3 mb-10">
          <div class="w-3 h-6 bg-cyan-500 shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
          <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-wider">
            05 // TRANSMIT_SIGNAL & CONTACT_INFO
          </h2>
        </div>

        <!-- DIRECT CONTACT CARDS GRID -->
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 mb-10">
          
          <!-- EMAIL CARD -->
          <a href="mailto:<%= profile.email %>" class="p-4 rounded bg-gray-50 dark:bg-cyber-bg/80 border border-gray-200 dark:border-cyan-950 hover:border-cyan-500/80 transition-all duration-300 group flex items-start space-x-3">
            <div class="w-10 h-10 rounded bg-cyan-500/10 text-cyan-500 flex items-center justify-center flex-shrink-0 text-lg group-hover:scale-110 transition-transform">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="overflow-hidden">
              <span class="text-[10px] font-black uppercase tracking-wider text-gray-500 dark:text-gray-400 block">Direct Signal</span>
              <span class="text-xs font-bold text-gray-900 dark:text-cyan-300 truncate block group-hover:text-cyan-400 transition-colors"><%= profile.email %></span>
            </div>
          </a>

          <!-- PHONE CARD -->
          <a href="tel:<%= profile.phone %>" class="p-4 rounded bg-gray-50 dark:bg-cyber-bg/80 border border-gray-200 dark:border-cyan-950 hover:border-green-500/80 transition-all duration-300 group flex items-start space-x-3">
            <div class="w-10 h-10 rounded bg-green-500/10 text-green-500 flex items-center justify-center flex-shrink-0 text-lg group-hover:scale-110 transition-transform">
              <i class="fas fa-phone"></i>
            </div>
            <div>
              <span class="text-[10px] font-black uppercase tracking-wider text-gray-500 dark:text-gray-400 block">Voice Channel</span>
              <span class="text-xs font-bold text-gray-900 dark:text-green-300 block group-hover:text-green-400 transition-colors"><%= profile.phone %></span>
            </div>
          </a>

          <!-- LOCATION CARD -->
          <div class="p-4 rounded bg-gray-50 dark:bg-cyber-bg/80 border border-gray-200 dark:border-cyan-950 sm:col-span-2 md:col-span-1 flex items-start space-x-3">
            <div class="w-10 h-10 rounded bg-purple-500/10 text-purple-500 flex items-center justify-center flex-shrink-0 text-lg">
              <i class="fas fa-location-dot"></i>
            </div>
            <div>
              <span class="text-[10px] font-black uppercase tracking-wider text-gray-500 dark:text-gray-400 block">Current Node</span>
              <span class="text-xs font-bold text-gray-900 dark:text-purple-300 block"><%= profile.location %></span>
            </div>
          </div>

        </div>

        <!-- FORM HEADER -->
        <div class="border-t border-gray-200 dark:border-cyan-950/60 pt-8 mb-6">
          <h3 class="text-sm font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-2">// SEND DIRECT MESSAGE PAYLOAD</h3>
          <p class="text-xs text-gray-600 dark:text-gray-400">Transmit your inquiry, collaboration proposition, or project scope directly to the server matrix.</p>
        </div>

        <!-- CONTACT FORM -->
        <form id="contact-form" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-2">
                SENDER_NAME
              </label>
              <input type="text" id="name" name="name" required placeholder="e.g. Recruit Manager / Tech Lead" class="w-full bg-gray-50 dark:bg-cyber-bg/70 border border-gray-300 dark:border-cyan-950 text-gray-900 dark:text-white px-4 py-3 rounded focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors text-sm font-mono placeholder:text-gray-400 dark:placeholder:text-gray-600">
            </div>
            <div>
              <label for="email" class="block text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-2">
                RETURN_SIGNAL_EMAIL
              </label>
              <input type="email" id="email" name="email" required placeholder="name@company.com" class="w-full bg-gray-50 dark:bg-cyber-bg/70 border border-gray-300 dark:border-cyan-950 text-gray-900 dark:text-white px-4 py-3 rounded focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors text-sm font-mono placeholder:text-gray-400 dark:placeholder:text-gray-600">
            </div>
          </div>
          <div>
            <label for="message" class="block text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400 mb-2">
              ENCRYPTED_MESSAGE_PAYLOAD
            </label>
            <textarea id="message" name="message" rows="5" required placeholder="Enter role requirements, project brief, or message details..." class="w-full bg-gray-50 dark:bg-cyber-bg/70 border border-gray-300 dark:border-cyan-950 text-gray-900 dark:text-white px-4 py-3 rounded focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors text-sm font-mono placeholder:text-gray-400 dark:placeholder:text-gray-600"></textarea>
          </div>

          <button type="submit" id="submit-btn" class="w-full py-4 bg-gradient-to-r from-cyan-500 to-green-500 hover:from-cyan-400 hover:to-green-400 text-gray-950 font-black uppercase tracking-widest text-sm rounded shadow-[0_0_20px_rgba(6,182,212,0.3)] hover:shadow-[0_0_25px_rgba(6,182,212,0.6)] transition-all duration-300 cursor-pointer flex items-center justify-center space-x-2">
            <span id="btn-text">BROADCAST_PAYLOAD.SH</span>
            <i id="btn-icon" class="fas fa-paper-plane"></i>
          </button>
        </form>

        <!-- SOCIAL ICONS MATRIX -->
        <div class="flex flex-wrap justify-center items-center gap-6 md:gap-10 mt-12 pt-8 border-t border-gray-200 dark:border-cyan-950/60">
          <a href="<%= profile.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="flex items-center space-x-2 text-gray-600 dark:text-gray-400 hover:text-cyan-400 text-sm font-bold uppercase transition-colors">
            <i class="fab fa-github text-xl neon-glow-cyan"></i>
            <span>github/arunkahar09</span>
          </a>
          <a href="<%= profile.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex items-center space-x-2 text-gray-600 dark:text-gray-400 hover:text-cyan-400 text-sm font-bold uppercase transition-colors">
            <i class="fab fa-linkedin text-xl neon-glow-cyan"></i>
            <span>linkedin/in/arunkahar09</span>
          </a>
          <a href="mailto:<%= profile.email %>" aria-label="Email" class="flex items-center space-x-2 text-gray-600 dark:text-gray-400 hover:text-cyan-400 text-sm font-bold uppercase transition-colors">
            <i class="fas fa-envelope text-xl neon-glow-cyan"></i>
            <span><%= profile.email %></span>
          </a>
        </div>
      </div>
    </div>
  </section>
