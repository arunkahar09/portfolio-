  <!-- PROJECTS MATRIX -->
  <section id="projects" class="py-24 bg-gray-100/50 dark:bg-cyber-card/20 border-t border-cyan-950/20 relative">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="flex items-center space-x-3 mb-16 justify-center">
        <div class="w-3 h-6 bg-cyan-500 shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
        <h2 class="text-2xl md:text-3xl font-black text-gray-900 dark:text-white uppercase tracking-widest text-center">
          04 // FUNCTIONAL_PROJECTS_DEPLOYMENTS
        </h2>
      </div>

      <!-- DEPLOYMENTS GRID -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <% if (projects && projects.length > 0) { %>
          <% projects.forEach(function(project) { %>
            <div class="tech-border bg-white dark:bg-cyber-card border border-gray-200 dark:border-cyan-950/80 overflow-hidden shadow-xl group hover:border-cyan-500/80 hover:shadow-[0_0_25px_rgba(6,182,212,0.2)] transition-all duration-300 flex flex-col justify-between">
              
              <div>
                <!-- PROJECT PREVIEW IMAGE -->
                <div class="overflow-hidden relative h-48 bg-gray-900">
                  <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500 filter grayscale contrast-125 group-hover:grayscale-0">
                  <div class="absolute inset-0 bg-gradient-to-t from-cyber-bg to-transparent opacity-70"></div>
                  <% if (project.category) { %>
                    <div class="absolute top-3 right-3 bg-cyber-bg/90 border border-cyan-500/40 px-2 py-0.5 rounded text-[10px] text-cyan-400 font-bold uppercase tracking-wider">
                      <%= project.category %>
                    </div>
                  <% } %>
                </div>

                <!-- PROJECT CONTENT -->
                <div class="p-6 space-y-3">
                  <h3 class="text-lg font-black text-gray-900 dark:text-white uppercase tracking-wider">
                    <%= project.title %>
                  </h3>
                  
                  <% if (project.subtitle) { %>
                    <p class="text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wide">
                      <%= project.subtitle %>
                    </p>
                  <% } %>

                  <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">
                    <%= project.description %>
                  </p>

                  <!-- TECH TAGS -->
                  <% if (project.tech && project.tech.length > 0) { %>
                    <div class="flex flex-wrap gap-1.5 pt-2">
                      <% project.tech.forEach(function(t) { %>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
                          <%= t %>
                        </span>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- PROJECT ACTIONS -->
              <div class="p-6 pt-0 flex items-center justify-between border-t border-gray-100 dark:border-cyan-950/40 mt-4">
                <button type="button" onclick="openProjectModal('<%= project.id %>')" class="inline-flex items-center space-x-2 text-xs font-black uppercase tracking-widest text-cyan-500 dark:text-cyan-400 hover:text-cyan-600 dark:hover:text-cyan-300 transition-colors cursor-pointer">
                  <span>EXPLORE_SPEC</span>
                  <i class="fas fa-arrow-right"></i>
                </button>
                
                <% if (project.github) { %>
                  <a href="<%= project.github %>" target="_blank" rel="noopener noreferrer" class="text-gray-500 dark:text-gray-400 hover:text-cyan-400 text-base transition-colors" title="View GitHub Source">
                    <i class="fab fa-github"></i>
                  </a>
                <% } %>
              </div>

            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>
